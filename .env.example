# ==========================================
# TESTPLATFORM PRO - ENVIRONMENT VARIABLES
# ==========================================

# Supabase PostgreSQL Configuration
# O'zingizning Supabase loyihangizdan oling (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Telegram Bot Configuration
# Telegram @BotFather orqali yaratilgan bot tokeni
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Admin/O'qituvchi Telegram Chat ID (@userinfobot orqali bilish mumkin)
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id_here

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
